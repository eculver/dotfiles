#!/bin/sh
# git gpg.ssh.program for the devenv: sign with the host's systemd user
# ssh-agent rather than whatever SSH_AUTH_SOCK points at (often a forwarded
# Mac agent that does not hold the devenv key). See ~/.gitconfig-devenv.
SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/openssh_agent"
export SSH_AUTH_SOCK
exec ssh-keygen "$@"
