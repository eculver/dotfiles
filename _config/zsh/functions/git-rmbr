main() {
  # `emulate -L zsh` resets options to a clean zsh baseline and, via
  # the `-L` flag, implies LOCAL_OPTIONS + LOCAL_TRAPS so any setopt
  # below is automatically reverted when this function returns. Without
  # this, options set inside an autoloaded function leak into the
  # caller's interactive shell.
  emulate -L zsh
  setopt err_exit    # abort on the first failing command
  setopt no_unset    # fail loudly on unset variable references
  setopt pipe_fail   # a pipeline's exit code is the rightmost non-zero

  local -a protected_branches=(main master develop dev)
  local current_branch protected reply

  current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [[ -z "${current_branch}" || "${current_branch}" == "HEAD" ]]; then
    echo "Not on a branch (detached HEAD). Aborting." >&2
    return 1
  fi

  for protected in "${protected_branches[@]}"; do
    if [[ "${current_branch}" == "${protected}" ]]; then
      echo "Refusing to delete protected branch: ${current_branch}" >&2
      return 1
    fi
  done

  read -r "reply?Delete branch '${current_branch}'? [y/N] "
  if [[ ! "${reply}" =~ ^[Yy]$ ]]; then
    echo "Aborted."
    return 0
  fi

  if ! git show-ref --verify --quiet refs/heads/main; then
    echo "Branch 'main' does not exist locally. Aborting." >&2
    return 1
  fi

  git checkout main
  git pull --ff-only
  git branch -d "${current_branch}"
}

main "$@"
