# Refresh the 1Password SSH agent for both auth and signing by:
#  - fetching from origin (exercises the auth key)
#  - creating an empty signed commit, then soft-resetting it away
#    (exercises the signing key without touching the working tree or index)
main() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "refresh-ssh-agent: not inside a git repo" >&2
    return 1
  fi

  if git remote get-url origin >/dev/null 2>&1; then
    git fetch origin || {
      echo "refresh-ssh-agent: git fetch origin failed" >&2
      return 1
    }
  else
    echo "refresh-ssh-agent: no 'origin' remote, skipping fetch" >&2
  fi

  git commit --allow-empty -m "refresh-ssh-agent: dummy signed commit" || {
    echo "refresh-ssh-agent: signed commit failed" >&2
    return 1
  }
  git reset --soft HEAD~1
}

main "$@"
