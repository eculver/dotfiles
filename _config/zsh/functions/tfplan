# Run `terragrunt plan` across one or more workspaces and collect the output
# into a single Markdown file.
#
# usage: tfplan -o <outfile> [-j <n>] [-p <profile>] <workspace> [<workspace> ...]
#
# Repo-agnostic: the workspace name used in each heading is the workspace's
# absolute path with everything up to and including the top-level `terraform/`
# stripped, e.g. infra-platform/aws/production/eks/platform-usw1-1.

# Strip terragrunt log noise (leading HH:MM:SS.mmm timestamps and the
# "STDOUT/STDERR terraform:" prefixes) so the collected Markdown reads cleanly.
_tfp_clean() {
  awk '
    {
      line = $0
      sub(/^[0-9]+:[0-9]+:[0-9]+\.[0-9]+ /, "", line)
      sub(/^(STDOUT|STDERR) terraform: /, "", line)
      print line
    }
  ' "$1"
}

main() {
  # `emulate -L zsh` resets options to a clean zsh baseline and, via the `-L`
  # flag, implies LOCAL_OPTIONS + LOCAL_TRAPS so any setopt/trap below is
  # reverted on return instead of leaking into the interactive shell.
  emulate -L zsh
  setopt err_exit no_unset pipe_fail
  unsetopt monitor          # run background plans without job-control notices

  # Colors, only when stderr is a terminal.
  local c_green='' c_yellow='' c_red='' c_cyan='' c_dim='' c_reset=''
  if [[ -t 2 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]; then
    c_green=$'\033[0;32m'; c_yellow=$'\033[1;33m'; c_red=$'\033[0;31m'
    c_cyan=$'\033[0;36m';  c_dim=$'\033[2m';       c_reset=$'\033[0m'
  fi
  local usage="usage: tfplan -o <outfile> [-j <n>] [-p <profile>] <workspace> [<workspace> ...]"

  local outfile="" profile="${AWS_PROFILE:-admin}" max_jobs=0
  local -a workspaces=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--output)
        outfile="${2:-}"
        [[ -z "$outfile" ]] && { print -ru2 -- "tfplan: -o requires an output file path"; return 1; }
        shift 2 ;;
      -j|--jobs)
        max_jobs="${2:-}"
        [[ -z "$max_jobs" ]] && { print -ru2 -- "tfplan: -j requires a number"; return 1; }
        shift 2 ;;
      -p|--profile)
        profile="${2:-}"
        [[ -z "$profile" ]] && { print -ru2 -- "tfplan: -p requires a profile name"; return 1; }
        shift 2 ;;
      -h|--help)
        print -ru2 -- "$usage"; return 0 ;;
      -*)
        print -ru2 -- "tfplan: unknown option: $1"; print -ru2 -- "$usage"; return 1 ;;
      *)
        workspaces+=("$1"); shift ;;
    esac
  done

  if [[ -z "$outfile" ]]; then
    print -ru2 -- "$usage"; return 1
  fi
  if [[ ${#workspaces[@]} -eq 0 ]]; then
    print -ru2 -- "tfplan: at least one workspace path is required"; return 1
  fi
  if [[ "$max_jobs" != <-> ]]; then        # zsh: <-> matches a non-negative integer
    print -ru2 -- "tfplan: -j must be a non-negative integer"; return 1
  fi
  command -v terragrunt >/dev/null 2>&1 || {
    print -ru2 -- "${c_red}[ERR]${c_reset} terragrunt is not installed or not in PATH"; return 1
  }

  # Resolve each input to an absolute dir, a display label, and a temp file
  # for its captured output (plus a sidecar file for its exit code).
  local -a dirs labels planfiles ecfiles pids states start_times next_hb exit_codes
  local ws abs name pf
  for ws in "${workspaces[@]}"; do
    if [[ ! -d "$ws" ]]; then
      print -ru2 -- "${c_yellow}[!!]${c_reset} skipping '$ws': not a directory"
      continue
    fi
    abs="${ws:A}"                          # absolute path, symlinks resolved
    if [[ "$abs" == */terraform/* ]]; then
      name="${abs#*/terraform/}"           # strip up to & including top-level terraform/
    else
      print -ru2 -- "${c_yellow}[!!]${c_reset} '$ws' is not under a 'terraform/' path; using full path as name"
      name="$abs"
    fi
    pf="$(mktemp "${TMPDIR:-/tmp}/tfplan.XXXXXX")"
    dirs+=("$abs"); labels+=("$name"); planfiles+=("$pf"); ecfiles+=("$pf.ec")
    pids+=(""); states+=("pending"); start_times+=(0); next_hb+=(5); exit_codes+=("")
  done

  local total=${#dirs[@]}
  if [[ $total -eq 0 ]]; then
    print -ru2 -- "tfplan: no valid workspaces to plan"; return 1
  fi
  (( max_jobs <= 0 )) && max_jobs=$total

  # On interrupt, kill any running plans and clean up temp files.
  trap 'kill ${pids:#} 2>/dev/null; rm -f "${planfiles[@]}" "${ecfiles[@]}" 2>/dev/null; return 130' INT TERM

  print -ru2 -- "${c_cyan}[..]${c_reset} planning ${total} workspace(s) as profile '${profile}', up to ${max_jobs} in parallel"

  local heartbeat=5
  local launched=0 completed=0 active=0 i ec runtime summary el
  while (( completed < total )); do
    # Launch up to the concurrency cap. Each job captures combined output to its
    # plan file, then records its exit code to the sidecar — checking the
    # sidecar for completion sidesteps kill -0 / zombie-reaping races.
    while (( launched < total && active < max_jobs )); do
      i=$((launched + 1))
      print -ru2 -- "${c_cyan}[..]${c_reset} [$i/$total] starting ${labels[$i]}"
      {
        # The `if` keeps err_exit from aborting the job before we record the
        # exit code on a failing plan (which is exactly the case we surface).
        if ( cd "${dirs[$i]}" || exit 1; AWS_PROFILE="$profile" terragrunt plan -no-color ) >| "${planfiles[$i]}" 2>&1; then
          print -r -- 0 >| "${ecfiles[$i]}"
        else
          print -r -- $? >| "${ecfiles[$i]}"
        fi
      } &
      pids[$i]=$!
      start_times[$i]=$SECONDS
      next_hb[$i]=$heartbeat
      states[$i]="running"
      launched=$((launched + 1))
      active=$((active + 1))
    done

    for (( i=1; i<=total; i++ )); do
      [[ "${states[$i]}" == "running" ]] || continue
      if [[ -s "${ecfiles[$i]}" ]]; then
        wait "${pids[$i]}" 2>/dev/null || true
        ec="$(<"${ecfiles[$i]}")"
        runtime=$((SECONDS - start_times[$i]))
        exit_codes[$i]="$ec"
        states[$i]="done"
        summary="$(_tfp_clean "${planfiles[$i]}" | grep -E 'Plan: [0-9]+ to (add|change|destroy)|No changes\.' | head -n1 || true)"
        [[ -z "$summary" ]] && summary="(no plan summary found)"
        if (( ec == 0 )); then
          print -ru2 -- "${c_green}[OK]${c_reset}  [$i/$total] ${labels[$i]} (${runtime}s) — ${summary}"
        else
          # Surface the failure on stderr instead of burying it in the file.
          print -ru2 -- "${c_red}[ERR]${c_reset} [$i/$total] ${labels[$i]} failed (exit ${ec}, ${runtime}s):"
          _tfp_clean "${planfiles[$i]}" | sed 's/^/      /' >&2
        fi
        active=$((active - 1))
        completed=$((completed + 1))
      else
        el=$((SECONDS - start_times[$i]))
        if (( el >= next_hb[$i] )); then
          print -ru2 -- "${c_dim}[..]  [$i/$total] ${labels[$i]} still running (${el}s)${c_reset}"
          next_hb[$i]=$((next_hb[$i] + heartbeat))
        fi
      fi
    done

    (( completed < total )) && sleep 1
  done

  # Write the combined Markdown: each plan in a collapsible <details> block.
  mkdir -p "${outfile:h}"
  : >| "$outfile"
  for (( i=1; i<=total; i++ )); do
    (( i > 1 )) && print -- "" >> "$outfile"
    {
      print -r -- "<details>"
      print -r -- ""
      print -r -- "<summary>"
      print -r -- ""
      print -r -- "## \`${labels[$i]}\`"
      print -r -- ""
      print -r -- "</summary>"
      print -r -- ""
      print -r -- '```'
      _tfp_clean "${planfiles[$i]}"
      print -r -- '```'
      print -r -- ""
      print -r -- "</details>"
    } >> "$outfile"
  done

  rm -f "${planfiles[@]}" "${ecfiles[@]}" 2>/dev/null

  # Copy the combined Markdown to the clipboard on macOS.
  if command -v pbcopy >/dev/null 2>&1; then
    pbcopy < "$outfile"
    print -ru2 -- "${c_dim}copied combined markdown to clipboard${c_reset}"
  fi

  local failed=0
  for (( i=1; i<=total; i++ )); do
    [[ "${exit_codes[$i]}" != "0" ]] && failed=$((failed + 1))
  done
  if (( failed > 0 )); then
    print -ru2 -- "${c_yellow}[!!]${c_reset} wrote ${outfile} — ${failed} of ${total} workspace(s) failed"
    return 1
  fi
  print -ru2 -- "${c_green}[OK]${c_reset}  wrote ${outfile}"
}

main "$@"
